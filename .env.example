# Managed identity provider (Architecture §5) — obtained after signing up per docs/SETUP.md
AUTH_PROVIDER_MODE=local
AUTH_PROVIDER_DOMAIN=
AUTH_PROVIDER_CLIENT_ID=
AUTH_PROVIDER_CLIENT_SECRET=

# Our own session token signing secret (Architecture §5) — generate a real random
# 32+ character value for any real deployment; never reuse this example value.
SESSION_JWT_SECRET=dev-only-secret-at-least-32-characters-long-for-testing

# PostgreSQL (Database Design v1.0) — connection string for the primary datastore
DATABASE_URL=postgres://user:password@localhost:5432/visualinux

# Redis (Architecture §14) — cache, leaderboard, rate limiting, gamification event queue
REDIS_URL=redis://localhost:6379

# API service
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
